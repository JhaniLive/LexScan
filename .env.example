# ── Your organisation's LLM ──────────────────────────────────────────
# The full endpoint URL, path included, exactly as it was handed to you:
#   https://llm.example.internal/v1/chat/completions
LOCAL_LLM_URL=

# The bearer token for that endpoint.
LOCAL_LLM_SECRET=

# ── Optional ─────────────────────────────────────────────────────────
# Model id sent in the request body. Leave blank and LexScan asks the
# endpoint's /models list and picks a chat model from it.
LLM_MODEL=

# Models offered in the settings dropdown (comma-separated). Leave blank
# to offer whatever /models reports, minus the embedding-only ones.
LLM_MODELS=

# Vision-capable model used to OCR scanned pages and photos. Leave blank
# if your LLM is text-only — uploads of scans will then say so plainly.
LLM_VISION_MODEL=

# Seconds to wait on a single call. Long contracts are slow.
LLM_TIMEOUT=600

# ── Pointing somewhere else instead ──────────────────────────────────
# openai = any other endpoint speaking OpenAI's /chat/completions
# custom = its own shape — edit CustomAdapter in app/llm.py
# Defaults to `local` whenever LOCAL_LLM_URL is set.
# LLM_PROVIDER=openai
# LLM_BASE_URL=
# LLM_API_KEY=

# ── Voice input ──────────────────────────────────────────────────────
# Speech is transcribed on this machine; no audio leaves it.
# tiny | base | small | medium — bigger is more accurate and slower.
STT_MODEL=base

# Force a language (en, hi, kn, ta, te, mr, bn ...). Blank = auto-detect,
# which handles code-switching between English and an Indian language.
STT_LANGUAGE=

# cpu or cuda
STT_DEVICE=cpu

# Live captions while you speak. The small model redraws the caption every
# couple of seconds; the accurate STT_MODEL above still does the final pass
# on the finished recording, and that is the text LexScan acts on.
STT_LIVE=true
STT_LIVE_MODEL=tiny
STT_LIVE_INTERVAL=1.6
STT_LIVE_WINDOW=12
